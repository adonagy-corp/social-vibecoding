# Usernode Social Vibecoding — environment template.
# For local-dev, copy to .env and fill in values. For production the
# real .env is generated on the VPS by .github/workflows/deploy.yml
# from GitHub repo secrets — see README "Standalone deployment".

# ── Auth ──────────────────────────────────────────────────────
# ADMIN_USERNAME / ADMIN_PASSWORD log you in as the platform admin.
# SESSION_SECRET signs express-session cookies; rotate it and everyone
# gets logged out.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=changeme-64-char-random-string

# ── Domain ────────────────────────────────────────────────────
# What hostname this instance runs at. Child apps get
# <slug>.<USERNODE_DOMAIN> (staging: <slug>--<user>--<sha>.<USERNODE_DOMAIN>),
# so DNS needs an A record for both the apex *and* the wildcard.
# Also templated into scaffolded apps' CLAUDE.md and "Open in
# Usernode" landing pages, and used by Caddy for the main vhost.
USERNODE_DOMAIN=usernode.example.com

# Canonical origin for the global CLI device-authorization service. The
# canonical production deployment must use the compiled first-party origin.
# Explicit local development (USERNODE_LOCAL_DEV=1) may instead use the
# loopback default http://localhost:3000 or set another valid local origin.
CLI_CANONICAL_ORIGIN=https://social-vibecoding.usernodelabs.org

# ── Database ──────────────────────────────────────────────────
# In the standalone docker-compose, the `usernode` service has its
# DATABASE_URL injected inline (pointing at the `usernode-db` service
# in the same network), so you only need USERNODE_DB_PASSWORD here for
# compose variable substitution. For local-dev outside docker, set
# DATABASE_URL explicitly too.
DATABASE_URL=postgres://usernode:localdev@usernode-db:5432/usernode
USERNODE_DB_PASSWORD=localdev
# Optional separate superuser URL for database creation/clone/export. When
# omitted, DATABASE_URL is used (the existing Compose setup already connects
# as the admin role).
# DB_ADMIN_URL=postgres://usernode:localdev@usernode-db:5432/usernode

# Runtime backend. Docker remains the default and supports the current
# single-server Compose deployment. Kubernetes is opt-in and never falls back.
# APP_RUNTIME=docker
# WORKER_RUNTIME=docker
# CAPTURE_RUNTIME=docker
# Keep the default true for Docker. Set false only when a Kubernetes
# migration Job runs scripts/migrate-kubernetes.js before the Deployment.
# RUN_MIGRATIONS_ON_STARTUP=false
# BUILD_NAMESPACE=social-builds
# APP_NAMESPACE=social-apps
# WORKER_NAMESPACE=social-workers
# REGISTRY_REPOSITORY_PREFIX=ghcr.io/example/social-apps
# CACHE_REPOSITORY_PREFIX=ghcr.io/example/social-build-cache
# BUILDER_IMAGE=docker.io/paketobuildpacks/ubuntu-noble-builder@sha256:...
# USERNODE_DOMAIN=apps.example.com
# INGRESS_CLASS_NAME=cilium
# CLUSTER_ISSUER=letsencrypt-public
# KUBERNETES_WORKER_IMAGE=ghcr.io/example/social-worker@sha256:...
# KUBERNETES_CAPTURE_IMAGE=ghcr.io/example/social-capture@sha256:...
# PLATFORM_INTERNAL_URL=http://social-platform.social-platform.svc.cluster.local:3000

# ── Platform keys ─────────────────────────────────────────────
# These used to be a single shared JWT_SECRET that signed every token
# type AND doubled as the at-rest encryption key AND was handed verbatim
# to every child-app container — so code running in a container could
# mint credentials the platform trusted, and could derive the key that
# decrypts every stored BYOK key.
#
# Phase 1 splits out the three authorities that need no coordinated
# cutover: the at-rest data key, worker tokens, and edge grants/cookies.
# None of those three is ever placed in a child container. JWT_SECRET
# survives below as an explicitly TRANSITIONAL key — it still signs
# iframe / capture / WebSocket / app-file identity tokens and is still
# injected into containers. Phase 2 moves that authority onto the RSA
# pair (containers then receive only IFRAME_JWT_PUBLIC_KEY, which cannot
# sign) and this entry goes away.
#
# JWT_SECRET — transitional. Set it to the SAME value as
# DATA_ENCRYPTION_KEY below: they are the same bytes, which is precisely
# why splitting the keys did not invalidate any stored ciphertext or any
# live iframe token. Optional in the sense that config.js falls back to
# DATA_ENCRYPTION_KEY when it is unset, but set it explicitly so the
# phase-2 removal is a clean deletion rather than a discovery.
JWT_SECRET=changeme-64-char-random-string

# DATA_ENCRYPTION_KEY — KDF input for the AES-256-GCM key that encrypts
# data at rest: user BYOK Anthropic keys and per-app secret values
# (src/services/secrets.js). NOT a signing key. If you are upgrading an
# existing instance, set this to your CURRENT JWT_SECRET value verbatim
# — this is a rename, not a rotation, and changing the value makes every
# stored BYOK key and app secret undecryptable.
#   New instances: openssl rand -hex 32
DATA_ENCRYPTION_KEY=changeme-64-char-random-string

# IFRAME_JWT_{PRIVATE,PUBLIC}_KEY — RSA-2048 pair (RS256) for the app
# identity tokens the shell injects into iframes. Asymmetric on purpose:
# child containers receive only the public half, so an app can verify
# who a user is but cannot forge a user. Both are single-line PEMs with
# literal \n escape sequences (same convention as GITHUB_PRIVATE_KEY);
# the process un-escapes at startup and refuses to boot on a mismatched
# pair or a modulus under 2048 bits. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out iframe.key && openssl pkey -in iframe.key -pubout -out iframe.pub
#   awk '{printf "%s\\n", $0}' iframe.key   # paste as PRIVATE
#   awk '{printf "%s\\n", $0}' iframe.pub   # paste as PUBLIC
IFRAME_JWT_PRIVATE_KEY=
IFRAME_JWT_PUBLIC_KEY=

# WORKER_JWT_SECRET — HMAC key for the tokens worker containers use to
# call the platform's internal API. Rotating it evicts warm workers on
# their next call (they re-bootstrap automatically).
#   openssl rand -hex 32
WORKER_JWT_SECRET=changeme-64-char-random-string

# EDGE_JWT_SECRET — HMAC key for private-app edge grants and the scoped
# per-host access cookie. Rotating it just makes people re-authorize.
#   openssl rand -hex 32
EDGE_JWT_SECRET=changeme-64-char-random-string

# ── GitHub App (for branches, PRs, pushes, issues) ────────────
# GITHUB_PRIVATE_KEY should be a single line with literal \n escape
# sequences — the process reads it and un-escapes at startup.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ── GitHub Bot PAT ────────────────────────────────────────────
# App tokens can't create repos on user accounts, so we also need a
# bot-user PAT with `repo` scope. Same token powers the /api/feedback
# "file a GitHub issue" flow — needs Issues:write on the feedback repo.
GITHUB_BOT_TOKEN=

# ── Chat connector + social identity credits ──────────────────
# All settings are optional and deploy safely. See "Chat connector
# operations" in SELF-HOSTING.md. In production set them in the Platform
# variables panel, not here.
#
# Dedicated GitHub OAuth app (NOT a GitHub App), callback URL
# https://<your-domain>/api/me/github/callback. No scope is requested;
# PKCE protects the code, the immutable account id + handle are read once,
# and the token is revoked and discarded. GitHub OAuth apps support only
# one callback URL, so this pair deliberately does NOT fall back to the
# waitlist app. Unset: GitHub linking is shown as unavailable.
# GITHUB_LINK_CLIENT_ID=
# GITHUB_LINK_CLIENT_SECRET=
#
# X OAuth 2.0 confidential client, callback URL
# https://<your-domain>/api/me/x/callback. Requests users.read + tweet.read,
# reads /2/users/me once, then revokes and discards the token. If this pair
# is unset, the WAITLIST_X pair below may be reused when that X app has BOTH
# exact callback URLs registered.
# X_LINK_CLIENT_ID=
# X_LINK_CLIENT_SECRET=
#
# Rollout switch for the daily allowance resolver:
#   legacy — current platform default / admin overrides (deploy-safe default)
#   tiered — unverified $0/day; verified GitHub OR X $10/day; overrides win
# Unknown values fail boot. BYOK continues to work in either mode.
IDENTITY_CREDIT_POLICY=legacy
#
# Hosts whose https redirect URIs a chat product may register against
# /mcp. An explicit value REPLACES the default below rather than
# extending it. Loopback is added automatically when USERNODE_LOCAL_DEV=1.
# MCP_CONNECTOR_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com

# ── Waitlist social connect (GitHub / X) ──────────────────────
# The stage-2 waitlist form ("Want in sooner?") can verify a signer's
# GitHub or X account instead of trusting a typed handle. All five are
# optional and each provider is judged on its own: BOTH halves of a pair
# must be set or that provider's connect button is not rendered at all —
# the free-text handle fields still work and nothing errors. Unset is a
# supported state, not a broken one. See "Waitlist social connect" in
# SELF-HOSTING.md for the developer-portal runbooks. In production set
# these in the Platform variables panel, not here.
#
# GitHub: a classic OAuth app (NOT a GitHub App), callback URL
# https://<your-domain>/waitlist/connect/github/callback. No scope is
# requested. This app is waitlist-only because GitHub permits one callback.
# WAITLIST_GITHUB_CLIENT_ID=
# WAITLIST_GITHUB_CLIENT_SECRET=
#
# X: an app inside a project at developer.x.com, "Web App, Automated App
# or Bot" (confidential client — a public client has no secret and the
# Basic-auth token exchange would fail), App permissions Read, callback
# URLs https://<your-domain>/waitlist/connect/x/callback and, when reused
# for account credits, https://<your-domain>/api/me/x/callback. The app NAME and
# Website URL you choose are shown to every user on the consent screen.
# Use the OAuth 2.0 Client ID / Client Secret, not the API Key / Bearer
# Token (those are OAuth 1.0a / app-only and unused here).
# WAITLIST_X_CLIENT_ID=
# WAITLIST_X_CLIENT_SECRET=
#
# Origin the two callback URLs above are built from. Unset: the
# production origin in production, http://localhost:$PORT in dev. Change
# it and you must register the matching callback with both providers.
# WAITLIST_OAUTH_ORIGIN=

# ── Self-hosting (platform repo URL) ──────────────────────────
# GitHub URL of *this* platform's source repo. Used by:
#   - the in-app feedback flow (file issues here)
#   - the import-flow guard (refuse to import this repo as a child app
#     once self-hosting is fully wired)
#   - the self-app boot seed
# Defaults to the canonical Usernode-Labs repo; override iff you're
# self-hosting from your own fork.
# USERNODE_PLATFORM_REPO=https://github.com/Usernode-Labs/social-vibecoding

# ── LLM (optional — BYOK fallback exists) ─────────────────────
# Admin-funded Anthropic key. Users can override with their own via
# the settings modal (BYOK); when they do their usage doesn't count
# against the admin budget. Leaving this blank makes the instance
# BYOK-only.
ANTHROPIC_API_KEY=

# ── Docker (child-app isolation) ──────────────────────────────
# Name of the Docker network child-app containers + Claude Code
# workers are attached to. Must match the network defined in
# docker-compose.yml — set DOCKER_NETWORK if you diverge from the
# default so worker.js + docker.js spawn onto the right network.
# DOCKER_NETWORK=usernode-net

# ── Local-dev convenience ─────────────────────────────────────
# When set, the platform returns http://localhost:<hostport> URLs for
# child apps instead of https://<slug>.<USERNODE_DOMAIN> — useful when
# running the whole stack on your laptop where Caddy can't issue real
# Let's Encrypt certs and DNS doesn't resolve. Leave blank in production.
# USERNODE_LOCAL_DEV=1
# CLI_CANONICAL_ORIGIN=http://localhost:3000

# ── Topochain (/api/v4 leaderboard, challenges, mobile) ────────
# The topochain surface — public standings, seasons/events, challenges,
# participant profiles, the mobile app's login + data endpoints, the
# partner and telemetry-ingest endpoints, and the Admin console's
# Topochain section — is served IN-PROCESS by this platform. There is no
# sidecar and no external leaderboard service; see SELF-HOSTING.md.
#
# Every key below is OPTIONAL: none of them block boot. Each one instead
# disables exactly one capability, listed with it. In production they are
# normally set through the platform's own Platform variables panel
# (dapp.json `platform_env`), not this file — .env is for local dev and
# for standalone deploys.
#
# Shared secret for the partner group's X-API-Key header. Unset: every
# /api/v4/partner/* request returns 500 "API key authentication is not
# configured." Generate with `openssl rand -hex 32`.
# TOPOCHAIN_PARTNER_API_KEY=
#
# Shared secret for the ingest group's X-Ingest-Key header (POST
# /api/v4/slot-outcomes and /api/v4/epoch-stats). Unset: every ingest
# WRITE returns 500 "Ingest key authentication is not configured."; the
# ingest reads stay public either way. Rotates independently of the
# partner key.
# TOPOCHAIN_INGEST_API_KEY=
#
# Base URL of the external zkPassport verification bridge. Unset: POST
# /api/v4/mobile/zkpassport/complete returns 500 "The zkPassport bridge
# is not configured."
# TOPOCHAIN_ZK_BRIDGE_URL=
#
# Outbound mail. ALL THREE are needed for a send to happen; with none set
# the platform logs "no mail transport configured", with only some set it
# logs which are missing. Unset is the quietest failure on this list:
# BOTH mail flows are always-success by contract, so they keep reporting
# OK to the user while delivering nothing —
#   * mobile email login (POST /api/v4/mobile/auth/otp/request) — the
#     user waits for a code that never arrives;
#   * onboarding waitlist confirmations.
# In dev/staging (NODE_ENV != production) the OTP code is printed to the
# log instead, so the flow stays completable by hand. Admin console →
# Topochain → Settings shows the configured/unconfigured state.
# TOPOCHAIN_MAIL_API_URL=https://api.resend.com/emails
# TOPOCHAIN_MAIL_API_KEY=
# TOPOCHAIN_MAIL_FROM=Usernode <no-reply@example.org>

# Mobile activity notifications default off. PUSH_ENV must exactly match the
# Flutter build environment (for example, production or staging). The
# service-account value is the complete Firebase JSON document, base64
# encoded on one line; provider registrations are encrypted at rest.
# MOBILE_PUSH_ENABLED=false
# PUSH_ENV=development
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# ── Usernode sidecar node ──────────────────────────────────────
# RPC URL for the Usernode sidecar (signature verification, wallet ops).
# In production docker-compose, this is set to http://usernode-node:3000
# automatically. For local dev outside Docker, point at a natively
# running node or override via NODE_RPC_URL in the environment.
# NODE_RPC_URL=http://localhost:3000

# Wallet linking: app public key + secret key for on-chain tx verification.
# Generate with: node scripts/generate-keypair.js --env (from dapp-starter)
# USERNODE_APP_PUBKEY=ut1...
# USERNODE_APP_SECRET_KEY=utsk1...

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Scaling / concurrency tunables ────────────────────────────
# All optional; the values below are the built-in defaults. Raise them
# (and the matching container limits in docker-compose.yml) to support
# more concurrent dev sessions. In prod these are set by the deploy
# workflow from GitHub repo vars; locally set them here.
#
# Server-wide cap on live (non-errored) apps that can exist on this
# host. Counted across all users; full admins bypass it. Set <= 0 to
# disable the cap. Built-in default is 30.
# MAX_APPS=30
# Platform-wide ceiling on active+promoted sessions. Each session can
# hold a warm worker container + a staging container, so this bounds
# host resource fan-out more than user count does.
# MAX_GLOBAL_SESSIONS=25
# Per-user ceiling on active+promoted sessions.
# MAX_USER_SESSIONS=3
# Per-session worker container limits (passed to `docker run`). Shrink
# to fit more concurrent warm workers on one box. Docker memory units:
# use e.g. 1280m / 2g (avoid decimals like 1.25g).
# NB: WORKER_CPUS is the dominant knob for build-turn speed on apps with
# their own test suite — `node --test` already fans out across files, so
# a 1-CPU quota serializes what would otherwise run in parallel. --cpus
# is a quota, not a reservation; on a box with idle cores, 4 is a safe
# default even with several concurrent workers.
# WORKER_MEMORY=2g
# WORKER_CPUS=4
# Unit-suite check: every proposal checks run also executes the repo's own
# `npm test` (when package.json declares a real test script) in a one-shot
# worker-image container, concurrent with the browser checks, and reports
# it as one synthetic check row. Advisory until the app is first observed
# passing it, merge-blocking after (#1019 earned gating). Set to 0 to
# disable fleet-wide.
# UNIT_SUITE_CHECK_ENABLED=1
# Container budgets for that run (clone + npm ci + npm test all inside
# UNIT_SUITE_TIMEOUT_MS; overrun fails the row, not the checks run).
# UNIT_SUITE_TIMEOUT_MS=600000
# UNIT_SUITE_CPUS=4
# UNIT_SUITE_MEMORY=2g
# UNIT_SUITE_IMAGE=usernode-worker:latest
# How long a worker sits idle before eviction (ms). Lower it under load
# to reclaim worker RAM sooner; the tradeoff is a cold re-bootstrap on
# the next message. Default 600000 (10 min).
# WORKER_IDLE_EVICTION_MS=600000
# Postgres connection pool size (pg Pool.max). Widen alongside the
# usernode-db container's CPU/memory limits. Default 10.
# DB_POOL_MAX=10
# Session auto-pause: a background sweeper flips idle 'active' sessions
# to 'paused' so they stop counting against the session caps (the CC
# volume + branch + PR + staging preview are all kept; reopening auto-
# resumes). Pause is cheap (no staging teardown) and the dev-chat
# heartbeat keeps last_activity_at fresh while the tab is open, so this
# is tuned to line up with WORKER_IDLE_EVICTION_MS (~5 min after the user
# actually leaves). Default 5 min; set to 0 to disable.
# SESSION_AUTOPAUSE_IDLE_MS=300000
# Staging GC: pause keeps the staging preview up for cheap resumes, so a
# separate, longer sweeper reclaims the staging container + cloned DB
# once a session has been cold this long (promoted/merging sessions are
# exempt — their preview backs group voting). Default 6h; 0 disables.
# STAGING_IDLE_TEARDOWN_MS=21600000
# How often the session sweeper scans for idle sessions. Default 60s.
# SESSION_SWEEP_INTERVAL_MS=60000
# When a user at their session cap reopens/resumes a paused session,
# auto-pause their least-recently-active session to make room instead of
# refusing. Set to false to keep the old hard 429. Default true.
# SESSION_LRU_ON_RESUME=true
# Demand-driven global-cap eviction. When the platform is at the global
# session cap and a new session is needed, pause the globally least-
# recently-active session that's been idle longer than this window (and
# isn't mid-turn) to free a slot immediately — instead of making the new
# user wait for the slow auto-pause. Protects anyone actively working.
# Default 15 min; set to 0 to disable (hard 429 at the global cap).
# SESSION_PRESSURE_GRACE_MS=900000
# Stale-promoted-PR policy. A promoted PR with no voting interest for
# PR_STALE_NOTIFY_MS gets its author a one-time "going stale" notification;
# if still untouched PR_STALE_GRACE_MS later it's auto-archived (reversible).
# Casting a vote revives it. Default: notify after 7d, archive 3d later.
# Set PR_STALE_NOTIFY_MS=0 to disable the policy entirely.
# PR_STALE_NOTIFY_MS=604800000
# PR_STALE_GRACE_MS=259200000
# Reversible-archive retention. Archiving keeps the CC volume + branch so
# /unarchive can restore a session; a background GC purges the CC volume
# (Claude's memory) only after this long. The row + branch survive, so
# unarchive still works afterward but starts a fresh chat. Default 30d;
# set to 0 to keep CC volumes forever (no hard GC).
# ARCHIVED_RETENTION_MS=2592000000
# How often the stale-PR / archived-GC sweeper runs (day-scale work, so
# infrequent). Default 1h.
# STALE_SWEEP_INTERVAL_MS=3600000

# ── OpenRouter BYOK with Codex (plan.md) ──────────────────────────────
# Available alongside Claude by default. This flag is an emergency
# availability switch, not a global provider choice: users select the
# coding agent for each session. Set false to disable the Codex option.
# Direct-transport only: Codex is configured to call the user's OpenRouter
# key directly (never through a platform proxy).
CODEX_OPENROUTER_ENABLED=true
# Provider-neutral LLM usage telemetry. Set false to stop NEW collection;
# existing admin aggregates remain readable. Does not change LLM behavior.
LLM_TELEMETRY_ENABLED=true
# Optional comma-separated allowlist of user ids; empty = available to all.
CODEX_OPENROUTER_BETA_USER_IDS=
# Optional initial Codex model slug when a user has not saved a choice.
# The UI otherwise recommends a verified model while exposing every model
# returned by that user's OpenRouter catalog.
OPENROUTER_DEFAULT_CODEX_MODEL=
# Override the OpenRouter API base (defaults to https://openrouter.ai/api/v1).
# Must be an HTTPS origin.
OPENROUTER_API_BASE=
# Origin used in OpenRouter attribution headers (HTTP-Referer / X-OpenRouter-Title)
OPENROUTER_ORIGIN=
